{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lokal Skriveflate",
  "version": "0.1.0",
  "identifier": "no.quentin.lokalskriveflate",
  "build": {
    "beforeDevCommand": "./node_modules/.bin/vite --host 0.0.0.0 --port 1420 --strictPort",
    "beforeBuildCommand": "./node_modules/.bin/vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lokal Skriveflate",
        "width": 1680,
        "height": 1040,
        "minWidth": 1240,
        "minHeight": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/codex",
      "binaries/llama-server"
    ],
    "resources": [
      "resources/embedded-runtime/manifest.json",
      "resources/embedded-runtime/staged/llama-server",
      "resources/embedded-runtime/staged/*.gguf"
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
